# Get this from @BotFather on Telegram
BOT_TOKEN=

# Default IANA timezone for new users (e.g. Asia/Manila, America/New_York)
DEFAULT_TZ=Asia/Manila

# SQLite file path (relative to project root or absolute)
DB_PATH=headsup.db

# Optional: chat_id that receives /feedback messages
ADMIN_CHAT_ID=

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
